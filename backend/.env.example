# Server Configuration
PORT=4000
JWT_SECRET=replace-with-a-random-64-char-hex-secret-in-production

# AI Provider API Keys (Server-side only — never exposed to browser!)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
ZHIPU_API_KEY=your_zhipu_api_key_here

# Optional Real SMTP for Email Verification (falls back to Ethereal Email / Demo OTP if omitted)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="StudyPilot AI <your_email@gmail.com>"
